{
  "description": "Verify an explicitly active Smart Harness work unit before stopping.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/tools/hook_check.py",
              "--host",
              "claude"
            ],
            "timeout": 600
          }
        ]
      }
    ]
  }
}
